#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    behaviors {
        td_e_3: td_e_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_E_3";
            #binding-cells = <0>;
            bindings = <&kp E>, <&kp N3>;

            tapping-term-ms = <150>;
        };

        td_tab_tilde: td_tab_tilde {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_TAB_TILDE";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&kp TILDE>;

            tapping-term-ms = <150>;
        };

        td_space_enter: td_space_enter {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SPACE_ENTER";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&kp ENTER>;
        };

        td_bl_switch: td_bl_switch {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BL_SWITCH";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&bt BT_NXT>, <&bt BT_PRV>;

            tapping-term-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&td_tab_tilde  &kp Q  &kp W  &td_e_3   &kp R  &kp T      &to 4     &kp PRINTSCREEN  &kp Y    &kp U  &kp I            &kp O    &kp P     &kp BSPC
&kp LCTRL      &kp A  &kp S  &kp D     &kp F  &kp G      &kp LALT  &td_bl_switch    &kp H    &kp J  &kp K            &kp L    &kp SEMI  &kp SQT
&kp LSHFT      &kp Z  &kp X  &kp C     &kp V  &kp B                                 &kp N    &kp M  &kp COMMA        &kp DOT  &kp FSLH  &kp ESC
                             &kp LGUI  &mo 1  &kp SPACE                             &kp RET  &mo 2  &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        NUMBER {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |      |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
&kp ESC          &kp N1        &kp N2          &kp N3          &kp N4        &kp N5           &bt BT_CLR   &kp RCTRL  &trans    &trans    &trans  &trans     &trans  &trans
&rgb_ug RGB_TOG  &kp NUMBER_6  &kp NUMBER_7    &kp NUMBER_8    &kp NUMBER_9  &kp NUMBER_0     &bootloader  &trans     &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&kp LSHFT        &kp F11       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW                          &trans    &trans    &trans  &trans     &trans  &trans
                                               &kp LGUI        &trans        &td_space_enter                          &kp LGUI  &trans    &trans
            >;
        };

        SYMBOL {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp LCTRL  &kp RCTRL  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans    &trans     &kp LALT   &trans     &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans    &trans                           &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &trans    &kp SPACE                        &kp RET    &trans     &trans
            >;
        };

        SPECIAL {
            display-name = "SPECIAL";
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &kp PAGE_UP    &trans  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_MUTE  &kp C_PLAY_PAUSE  &bootloader      &bt BT_CLR
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &kp PAGE_DOWN  &trans  &kp RIGHT_ALT      &kp CAPS         &trans      &trans            &rgb_ug RGB_TOG  &studio_unlock
&trans  &kp F11  &kp F12  &trans  &trans  &trans                          &trans             &trans           &trans      &bt BT_SEL 0      &bt BT_SEL 1     &bt BT_SEL 2
                          &trans  &trans  &trans                          &trans             &trans           &trans
            >;
        };

        starcraft2 {
            display-name = "starcraft2";
            bindings = <
&kp TAB    &trans  &trans  &trans     &trans          &trans        &to 0          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp ESC    &trans  &trans  &trans     &trans          &trans        &kp BACKSPACE  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp SPACE  &trans  &trans  &trans     &trans          &trans                               &trans  &trans  &trans  &trans  &trans  &trans
                           &kp LCTRL  &kp LEFT_SHIFT  &kp LEFT_ALT                         &trans  &trans  &trans
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
